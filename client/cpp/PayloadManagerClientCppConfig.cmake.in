@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Arrow REQUIRED)
find_dependency(gRPC REQUIRED)
find_dependency(Protobuf REQUIRED)
# ring.cc logs through spdlog; without this the imported target's
# INTERFACE_LINK_LIBRARIES names spdlog::spdlog before anything defines it.
find_dependency(spdlog REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/PayloadManagerClientTargets.cmake")

check_required_components(PayloadManagerClientCpp)
