ARG ARROW_VERSION=25.0.1

FROM nvidia/cuda:13.3.1-devel-ubuntu26.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# Apache Arrow apt repository — provides libarrow-dev / libarrow-cuda-dev at an
# exact pinned version.  Ubuntu universe only carries Arrow 23.0.1 and has no
# CUDA build, so the Apache repo is used for every image to keep one version.
ARG ARROW_VERSION
RUN sed -i 's/^Components: main$/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && wget -q -O /tmp/arrow-apt-source.deb \
         https://apache.jfrog.io/artifactory/arrow/ubuntu/apache-arrow-apt-source-latest-resolute.deb \
    && apt-get install -y -V /tmp/arrow-apt-source.deb \
    && rm -f /tmp/arrow-apt-source.deb \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        protobuf-compiler \
        libprotobuf-dev \
        libgrpc++-dev \
        libgrpc-dev \
        libyaml-cpp-dev \
        libpqxx-dev \
        libspdlog-dev \
        libcurl4-openssl-dev \
        protobuf-compiler-grpc \
        libssl-dev \
        zlib1g-dev \
        liblz4-dev \
        libzstd-dev \
        libsnappy-dev \
        libbrotli-dev \
        libbz2-dev \
        libre2-dev \
        libutf8proc-dev \
        libxml2-dev \
        libgtest-dev \
        libarrow-dev=${ARROW_VERSION}-1 \
        libarrow-cuda-dev=${ARROW_VERSION}-1 \
        opentelemetry-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . ./src

# libcuda.so.1 stub is required at link time when building against the CUDA
# devel image; the real libcuda.so.1 is provided by the driver at runtime.
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && cmake -S ./src -B /workspace/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DPAYLOAD_MANAGER_ENABLE_OTEL=ON \
        -DPAYLOAD_MANAGER_ENABLE_ARROW_CUDA=ON \
        -DBUILD_TESTING=ON \
        -DPAYLOAD_MANAGER_BUILD_SERVICE=ON \
        -DPAYLOAD_MANAGER_BUILD_CLIENT=OFF \
        -DPAYLOAD_MANAGER_BUILD_EXAMPLES=OFF \
        -DPAYLOAD_MANAGER_BUILD_PAYLOADCTL=OFF \
    && cmake --build /workspace/build \
    && LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH} \
       ctest --test-dir /workspace/build --output-on-failure -E payload_manager_integration_api -LE gpu

# -LE gpu above: docker build has no GPU (there is no --gpus for build), which is
# why the libcuda stub is linked at all. GPU-labelled tests would therefore just
# GTEST_SKIP here, reporting green without executing anything. They are run
# instead against a real device on a GPU runner:
#
#   docker build --target builder -t pm:cuda-builder -f docker/Dockerfile.cuda .
#   docker run --rm --gpus all pm:cuda-builder \
#     ctest --test-dir /workspace/build -L gpu --output-on-failure
#
# The builder stage keeps the test binaries; the runtime stage below carries
# only the service binary.


FROM nvidia/cuda:13.3.1-runtime-ubuntu26.04 AS runtime

LABEL org.opencontainers.image.title="payload-manager-cuda" \
      org.opencontainers.image.description="Payload Manager gRPC service with CUDA and OpenTelemetry"

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Apache Arrow apt repository — provides libarrow-dev / libarrow-cuda-dev at an
# exact pinned version.  Ubuntu universe only carries Arrow 23.0.1 and has no
# CUDA build, so the Apache repo is used for every image to keep one version.
ARG ARROW_VERSION
RUN sed -i 's/^Components: main$/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && wget -q -O /tmp/arrow-apt-source.deb \
         https://apache.jfrog.io/artifactory/arrow/ubuntu/apache-arrow-apt-source-latest-resolute.deb \
    && apt-get install -y -V /tmp/arrow-apt-source.deb \
    && rm -f /tmp/arrow-apt-source.deb \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libprotobuf32t64 \
        libgrpc++1.51t64 \
        libgrpc29t64 \
        libyaml-cpp0.8 \
        libpq5 \
        libspdlog1.15 \
        libcurl4t64 \
        libssl3t64 \
        zlib1g \
        liblz4-1 \
        libzstd1 \
        libsnappy1v5 \
        libbrotli1 \
        libbz2-1.0 \
        libre2-11 \
        libutf8proc3 \
        libxml2-16 \
        libarrow2500=${ARROW_VERSION}-1 \
        libarrow-cuda2500=${ARROW_VERSION}-1 \
        opentelemetry-cpp \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --no-create-home --shell /sbin/nologin payload

COPY --from=builder --chown=payload:payload /workspace/build/bin/payload-manager ./payload-manager

# Create the disk-tier root in the image, owned by the user the container runs
# as. Docker gives a named volume the ownership of the image directory it is
# mounted over, and creates that directory root-owned when the image has none
# — which left a non-root payload-manager unable to create its payloads/ tree
# and exiting 2 on every start against a fresh volume.
RUN mkdir -p /var/lib/payload-manager/payloads \
    && chown -R payload:payload /var/lib/payload-manager

EXPOSE 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/localhost/50051' || exit 1

USER payload
ENTRYPOINT ["./payload-manager"]
