FROM nvidia/cuda:13.3.1-devel-ubuntu26.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# NVIDIA's ubuntu2604 Packages index is malformed upstream -- five stanzas
# begin with Filename: instead of Package:, and apt aborts the whole update
# with "Encountered a section with no Package: header". Nothing here installs
# from that repository (the CUDA toolkit comes from the base image filesystem,
# not apt), so dropping the list is inert and makes the build independent of
# NVIDIA republishing. Remove this line once their index is fixed.
RUN rm -f /etc/apt/sources.list.d/cuda*.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        ca-certificates \
        python3 \
        python3-pip \
        python3-dev \
        libssl-dev \
        zlib1g-dev \
        liblz4-dev \
        libzstd-dev \
        libsnappy-dev \
        libbrotli-dev \
        libbz2-dev \
        libre2-dev \
        libutf8proc-dev \
    && rm -rf /var/lib/apt/lists/*

# Install pyarrow Python build deps up front (before the long Arrow C++ compile).
# Exactly what python/pyproject.toml lists under [build-system], because
# --no-build-isolation means pip installs none of it: pyarrow moved to
# scikit-build-core behind a thin _build_backend wrapper, and this list still
# named the setuptools-era set, so the build died on
# "BackendUnavailable: Cannot import '_build_backend'".
#
# --ignore-installed because pip cannot uninstall the dpkg-owned packaging to
# satisfy setuptools_scm, and stops with "Cannot uninstall packaging ... no
# RECORD file was found". Installing over it is fine; nothing here needs the
# Debian copy.
RUN pip3 install --break-system-packages --ignore-installed \
        "scikit-build-core" \
        "cython>=3.1" \
        "libcst>=1.8.6" \
        "setuptools>=77" \
        "setuptools_scm[toml]>=8" \
        "numpy>=1.25"

# No published pyarrow wheel or deb ships pyarrow.cuda, so this image builds
# Arrow C++ and pyarrow from source with CUDA enabled.  The source comes from a
# pinned shallow clone rather than a git submodule, and lives above the COPY of
# the project sources so editing the project does not invalidate this layer.
ARG ARROW_VERSION=25.0.1
RUN git clone --depth 1 --branch apache-arrow-${ARROW_VERSION} \
        https://github.com/apache/arrow.git /workspace/arrow

RUN cmake -S /workspace/arrow/cpp -B /workspace/arrow-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DARROW_BUILD_SHARED=ON \
        -DARROW_BUILD_STATIC=OFF \
        -DARROW_BUILD_TESTS=OFF \
        -DARROW_BUILD_BENCHMARKS=OFF \
        -DARROW_BUILD_EXAMPLES=OFF \
        -DARROW_BUILD_UTILITIES=OFF \
        -DARROW_BUILD_INTEGRATION=OFF \
        -DARROW_PYTHON=ON \
        -DARROW_ACERO=ON \
        -DARROW_COMPUTE=ON \
        -DARROW_FILESYSTEM=ON \
        -DARROW_IPC=ON \
        -DARROW_S3=OFF \
        -DARROW_GCS=OFF \
        -DARROW_AZURE=OFF \
        -DARROW_HDFS=OFF \
        -DARROW_FLIGHT=OFF \
        -DARROW_GANDIVA=OFF \
        -DARROW_PARQUET=OFF \
        -DARROW_DATASET=OFF \
        -DARROW_CSV=OFF \
        -DARROW_JSON=OFF \
        -DARROW_CUDA=ON \
        -DARROW_JEMALLOC=OFF \
        -DARROW_WITH_OPENTELEMETRY=OFF \
        -DARROW_WITH_LZ4=ON \
        -DARROW_WITH_ZSTD=ON \
        -DARROW_WITH_SNAPPY=ON \
        -DARROW_WITH_BROTLI=ON \
        -DARROW_WITH_BZ2=ON \
        -DARROW_WITH_ZLIB=ON \
        -DARROW_DEPENDENCY_SOURCE=AUTO \
    && cmake --build /workspace/arrow-build \
    && cmake --install /workspace/arrow-build \
    && rm -rf /workspace/arrow-build \
    && ldconfig \
    && cd /workspace/arrow/python \
    && ARROW_HOME=/usr/local \
       PYARROW_WITH_CUDA=1 \
       PYARROW_WITH_DATASET=0 \
       PYARROW_WITH_FLIGHT=0 \
       PYARROW_WITH_FLIGHT_SQL=0 \
       PYARROW_WITH_GANDIVA=0 \
       PYARROW_WITH_ORC=0 \
       PYARROW_WITH_PARQUET=0 \
       PYARROW_WITH_SUBSTRAIT=0 \
       PYARROW_WITH_S3=0 \
       PYARROW_WITH_GCS=0 \
       PYARROW_BUNDLE_ARROW_CPP=0 \
       pip3 install --break-system-packages --no-build-isolation . \
    && cd / \
    && cp -r "$(python3 -c 'import pyarrow, pathlib; print(pathlib.Path(pyarrow.__file__).parent)')" \
          /opt/pyarrow \
    && rm -rf /workspace/arrow


# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------
FROM nvidia/cuda:13.3.1-runtime-ubuntu26.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# NVIDIA's ubuntu2604 Packages index is malformed upstream -- five stanzas
# begin with Filename: instead of Package:, and apt aborts the whole update
# with "Encountered a section with no Package: header". Nothing here installs
# from that repository (the CUDA toolkit comes from the base image filesystem,
# not apt), so dropping the list is inert and makes the build independent of
# NVIDIA republishing. Remove this line once their index is fixed.
RUN rm -f /etc/apt/sources.list.d/cuda*.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-numpy \
        zlib1g \
        liblz4-1 \
        libzstd1 \
        libsnappy1v5 \
        libbrotli1 \
        libbz2-1.0 \
        libre2-11 \
        libutf8proc3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/libarrow* /usr/local/lib/
RUN ldconfig

# pyarrow's install path is interpreter-version-specific, so it cannot be
# written as a literal: this was hardcoded to python3.12 and stopped existing
# the moment the base moved to Ubuntu 26.04, which ships 3.14 -- COPY --from a
# missing path fails the build outright. The builder stages it at a fixed
# location and the runtime resolves its own site-packages, so a later base bump
# cannot break the copy again.
COPY --from=builder /opt/pyarrow /opt/pyarrow
RUN PYSITE="$(python3 -c 'import site; print(site.getsitepackages()[0])')" \
    && mkdir -p "$PYSITE" \
    && mv /opt/pyarrow "$PYSITE/pyarrow"

# Floors dictated by the committed stubs, not chosen -- see the note in
# Dockerfile.examples.python and the one in client/python/setup.py.
RUN pip3 install --no-cache-dir --break-system-packages \
    "grpcio>=1.75.1" \
    "protobuf>=6.31.1"

# Copy the cmake-generated Python client stubs and examples
COPY client/python /app/client/python
COPY examples/python /app/examples/python
COPY examples/run_python_examples.sh /app/run_python_examples.sh

RUN chmod +x /app/run_python_examples.sh

ENTRYPOINT ["/app/run_python_examples.sh"]
