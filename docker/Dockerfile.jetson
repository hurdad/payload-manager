# Dockerfile.jetson
#
# payload-manager for NVIDIA Jetson Orin (aarch64 / L4T / JetPack 6), with CUDA
# and OpenTelemetry enabled.
#
# No dependency is built here. Abseil, re2, Protobuf, gRPC, OpenTelemetry, the
# AWS SDK, Arrow and libpqxx come from the pair of images built by
# docker/Dockerfile.jetson-deps — a dev image carrying headers and the toolchain,
# and a runtime image carrying only the shared objects. Building those from
# source takes hours on Jetson hardware and none of it changes when this
# project's sources do, so this file rebuilds in minutes.
#
# To change a dependency version, edit docker/Dockerfile.jetson-deps and let
# .github/workflows/jetson-deps.yml publish a new pair of tags; the two ARGs
# below are what select them.
#
# Build on a Jetson device:
#   docker build -f docker/Dockerfile.jetson -t payload-manager:jetson .
#
# Against locally built dependency images rather than the published ones:
#   docker build -f docker/Dockerfile.jetson-deps --target dev \
#     -t pm-jetson-deps-dev:local .
#   docker build -f docker/Dockerfile.jetson-deps --target runtime \
#     -t pm-jetson-deps-runtime:local .
#   docker build -f docker/Dockerfile.jetson \
#     --build-arg DEPS_DEV_IMAGE=pm-jetson-deps-dev:local \
#     --build-arg DEPS_RUNTIME_IMAGE=pm-jetson-deps-runtime:local \
#     -t payload-manager:jetson .
#
# Cross-building from x86 needs binfmt and a great deal of patience:
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#   docker build --platform linux/arm64 -f docker/Dockerfile.jetson -t payload-manager:jetson .

ARG DEPS_DEV_IMAGE=ghcr.io/hurdad/payload-manager-jetson-deps-dev:latest
ARG DEPS_RUNTIME_IMAGE=ghcr.io/hurdad/payload-manager-jetson-deps-runtime:latest

# ============================================================
# Stage 1 – builder
# ============================================================
FROM ${DEPS_DEV_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# 4 is a desktop or CI default. A 7 GB Orin Nano wants 2 — Arrow is not built
# here, but the service's own heavier translation units still run well past a
# gigabyte each, and the board has only zram to fall back on.
ARG BUILD_JOBS=4

COPY . ./src

RUN cmake -S ./src -B /workspace/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_PREFIX_PATH=/usr/local \
        -DPAYLOAD_MANAGER_ENABLE_OTEL=ON \
        -DPAYLOAD_MANAGER_ENABLE_ARROW_CUDA=ON \
        -DBUILD_TESTING=ON \
        -DPAYLOAD_MANAGER_BUILD_SERVICE=ON \
        -DPAYLOAD_MANAGER_BUILD_CLIENT=OFF \
        -DPAYLOAD_MANAGER_BUILD_EXAMPLES=OFF \
        -DPAYLOAD_MANAGER_BUILD_PAYLOADCTL=OFF \
    && cmake --build /workspace/build -j ${BUILD_JOBS}

# Tests are not run here: the GPU suites need libcuda.so.1 from the NVIDIA
# container runtime, which is not present during a build. On-device:
#   docker build --target builder -t pm:jetson-builder -f docker/Dockerfile.jetson .
#   docker run --rm --runtime=nvidia pm:jetson-builder \
#     ctest --test-dir /workspace/build --output-on-failure -L unit

# ============================================================
# Stage 2 – runtime
# ============================================================
# The base already carries every shared object the binary links; see
# docker/Dockerfile.jetson-deps.
FROM ${DEPS_RUNTIME_IMAGE} AS runtime

LABEL org.opencontainers.image.title="payload-manager-jetson" \
      org.opencontainers.image.description="Payload Manager gRPC service for NVIDIA Jetson (L4T/JetPack 6), with CUDA and OpenTelemetry"

WORKDIR /app

RUN useradd --system --no-create-home --shell /sbin/nologin payload

COPY --from=builder --chown=payload:payload /workspace/build/bin/payload-manager ./payload-manager

# The disk tier writes here and the process runs unprivileged, so the directory
# has to exist and be owned before the drop. docker/Dockerfile does the same.
RUN mkdir -p /var/lib/payload-manager/payloads \
    && chown -R payload:payload /var/lib/payload-manager

EXPOSE 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/localhost/50051' || exit 1

USER payload
ENTRYPOINT ["./payload-manager"]
