# Dockerfile.jetpack6
#
# payload-manager for NVIDIA Jetson Orin (aarch64 / L4T R36 / JetPack 6), with
# CUDA and OpenTelemetry enabled.
#
# Named for the JetPack release rather than the board, because that is the axis
# everything here actually depends on: JetPack 6 fixes L4T R36, Ubuntu 22.04 and
# CUDA 12.2 together, and every base image tag and distro package name below
# follows from that trio. A Thor board is JetPack 7 — L4T R38, Ubuntu 24.04,
# CUDA 13 — and needs its own Dockerfile.jetpack7 pair rather than a flag here.
# See docker/README.md for what that would involve.
#
# No dependency is built here. Abseil, re2, Protobuf, gRPC, OpenTelemetry, the
# AWS SDK, Arrow and libpqxx come from the pair of images built by
# docker/Dockerfile.jetpack6-deps — a dev image carrying headers and the toolchain,
# and a runtime image carrying only the shared objects. Building those from
# source takes hours on Jetson hardware and none of it changes when this
# project's sources do, so this file rebuilds in minutes.
#
# To change a dependency version, edit docker/Dockerfile.jetpack6-deps and let
# .github/workflows/jetpack6-deps.yml publish a new pair of tags; the two ARGs
# below are what select them.
#
# Build on a Jetson device:
#   docker build -f docker/Dockerfile.jetpack6 -t payload-manager:jetpack6 .
#
# Against locally built dependency images rather than the published ones:
#   docker build -f docker/Dockerfile.jetpack6-deps --target dev \
#     -t pm-jetpack6-deps-dev:local .
#   docker build -f docker/Dockerfile.jetpack6-deps --target runtime \
#     -t pm-jetpack6-deps-runtime:local .
#   docker build -f docker/Dockerfile.jetpack6 \
#     --build-arg DEPS_DEV_IMAGE=pm-jetpack6-deps-dev:local \
#     --build-arg DEPS_RUNTIME_IMAGE=pm-jetpack6-deps-runtime:local \
#     -t payload-manager:jetpack6 .
#
# Cross-building from x86 needs binfmt and a great deal of patience:
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#   docker build --platform linux/arm64 -f docker/Dockerfile.jetpack6 -t payload-manager:jetpack6 .

ARG DEPS_DEV_IMAGE=ghcr.io/hurdad/payload-manager-jetpack6-deps-dev:latest
ARG DEPS_RUNTIME_IMAGE=ghcr.io/hurdad/payload-manager-jetpack6-deps-runtime:latest

# ============================================================
# Stage 1 – builder
# ============================================================
FROM ${DEPS_DEV_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# 6 is every core on an Orin Nano / Orin NX, and this stage is the cheap half:
# Arrow is not built here, and the service's own translation units stay near a
# gigabyte. Past the core count is pure oversubscription.
ARG BUILD_JOBS=6

COPY . ./src

RUN cmake -S ./src -B /workspace/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_PREFIX_PATH=/usr/local \
        -DPAYLOAD_MANAGER_ENABLE_OTEL=ON \
        -DPAYLOAD_MANAGER_ENABLE_ARROW_CUDA=ON \
        -DBUILD_TESTING=ON \
        -DPAYLOAD_MANAGER_BUILD_SERVICE=ON \
        -DPAYLOAD_MANAGER_BUILD_CLIENT=OFF \
        -DPAYLOAD_MANAGER_BUILD_EXAMPLES=OFF \
        -DPAYLOAD_MANAGER_BUILD_PAYLOADCTL=OFF \
    && cmake --build /workspace/build -j ${BUILD_JOBS}

# Tests are not run here: the GPU suites need libcuda.so.1 from the NVIDIA
# container runtime, which is not present during a build. On-device:
#   docker build --target builder -t pm:jetpack6-builder -f docker/Dockerfile.jetpack6 .
#   docker run --rm --runtime=nvidia pm:jetpack6-builder \
#     ctest --test-dir /workspace/build --output-on-failure -L unit

# ============================================================
# Stage 2 – runtime
# ============================================================
# The base already carries every shared object the binary links; see
# docker/Dockerfile.jetpack6-deps.
FROM ${DEPS_RUNTIME_IMAGE} AS runtime

LABEL org.opencontainers.image.title="payload-manager-jetpack6" \
      org.opencontainers.image.description="Payload Manager gRPC service for NVIDIA Jetson (L4T/JetPack 6), with CUDA and OpenTelemetry"

WORKDIR /app

RUN useradd --system --no-create-home --shell /sbin/nologin payload

COPY --from=builder --chown=payload:payload /workspace/build/bin/payload-manager ./payload-manager

# The disk tier writes here and the process runs unprivileged, so the directory
# has to exist and be owned before the drop. docker/Dockerfile does the same.
RUN mkdir -p /var/lib/payload-manager/payloads \
    && chown -R payload:payload /var/lib/payload-manager

EXPOSE 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/localhost/50051' || exit 1

USER payload
ENTRYPOINT ["./payload-manager"]
