{
  "swagger": "2.0",
  "info": {
    "title": "payload/manager/services/v1/payload_admin_service.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PayloadAdminService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/admin/stats": {
      "get": {
        "operationId": "PayloadAdminService_Stats",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1StatsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "PayloadAdminService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1RingStats": {
      "type": "object",
      "properties": {
        "ringId": {
          "type": "string"
        },
        "slotsTotal": {
          "type": "integer",
          "format": "int64",
          "description": "Configured slot count, and how many of those AcquireRingSlot could\ntake right now. slots_available hitting 0 is what makes a producer\nsee RESOURCE_EXHAUSTED and drop a capture."
        },
        "slotsAvailable": {
          "type": "integer",
          "format": "int64"
        },
        "slotsWriting": {
          "type": "integer",
          "format": "int64",
          "description": "Where the unavailable ones went: held by a producer mid-write, or\npinned by at least one consumer's read lease."
        },
        "slotsLeased": {
          "type": "integer",
          "format": "int64"
        },
        "leasesActive": {
          "type": "string",
          "format": "uint64",
          "description": "Sum of per-slot refcounts — several consumers may hold the same slot,\nso this can exceed slots_leased."
        },
        "slotsReclaimed": {
          "type": "string",
          "format": "uint64",
          "description": "Cumulative count of slots this ring has had to take back from a\nproducer that never committed, i.e. one that died mid-capture.\nMonotonic for the life of the process; any increase is worth an alert."
        },
        "slotCapacityBytes": {
          "type": "string",
          "format": "uint64"
        }
      },
      "description": "Per-ring slot accounting for TIER_RAM_RING.\n\nRings are not payloads: slots are pre-allocated and recycled in place,\nso the payload counts and tier bytes above never describe them. What an\noperator needs instead is headroom (how many slots can be acquired right\nnow) and whether reservations are being lost."
    },
    "v1StatsResponse": {
      "type": "object",
      "properties": {
        "payloadsGpu": {
          "type": "string",
          "format": "uint64"
        },
        "payloadsRam": {
          "type": "string",
          "format": "uint64"
        },
        "payloadsDisk": {
          "type": "string",
          "format": "uint64"
        },
        "payloadsObject": {
          "type": "string",
          "format": "uint64"
        },
        "bytesGpu": {
          "type": "string",
          "format": "uint64"
        },
        "bytesRam": {
          "type": "string",
          "format": "uint64"
        },
        "bytesDisk": {
          "type": "string",
          "format": "uint64"
        },
        "bytesObject": {
          "type": "string",
          "format": "uint64"
        },
        "rings": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1RingStats"
          },
          "description": "One entry per configured ring; empty when no ring tier is configured."
        }
      }
    }
  }
}
