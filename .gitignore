.idea
build
cmake-*

# Key material. Nothing here generates certificates yet, which is exactly why
# these patterns land before anything does: scripts/gen-dev-certs.sh writes into
# certs/, and a development CA key is still a private key.
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
certs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod
!go.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo
ui/test-results/
